# Live Supabase Connection (Optional - leave empty for automatic Mock Mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Ceibo AI Application Configuration
NEXT_PUBLIC_APP_NAME="Ceibo AI"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_TENANT_ID="ceibo-demo-tenant-01"
NEXT_PUBLIC_USE_MOCK_FALLBACK=true

# Mostrar accesos directos de demo en /login (solo para desarrollo/demo)
NEXT_PUBLIC_SHOW_DEMO_LOGINS=false

# Solo servidor (NUNCA con prefijo NEXT_PUBLIC_): lee empresa_integrations, el webhook de envio por empresa
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Webhook Configuration (compatibilidad: se usa SOLO para la empresa CEIBO_LEGACY_EMPRESA_ID
# mientras no tenga fila en empresa_integrations)
CEIBO_LEGACY_EMPRESA_ID=a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a11
CEIBO_HUMAN_MSG_WEBHOOK_URL=
